rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128;
    }

    function emailKey() {
      return request.auth.token.email.lower()
        .replace('@', '_')
        .replace('.', '_')
        .replace('+', '_')
        .replace('-', '_');
    }

    function isBootstrapAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'a.infj.13@gmail.com';
    }

    function staffPath() {
      return /databases/$(database)/documents/staff/$(emailKey());
    }

    function isActiveStaff() {
      return isVerified() && (
        isBootstrapAdmin() ||
        (exists(staffPath()) && (get(staffPath()).data.active == true || get(staffPath()).data.isActive == true))
      );
    }

    function isManager() {
      return isVerified() && (
        isBootstrapAdmin() ||
        (exists(staffPath()) && (get(staffPath()).data.active == true || get(staffPath()).data.isActive == true) &&
         (get(staffPath()).data.role in ['management', 'owner']))
      );
    }

    function isValidOptString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isValidTimestamp(val) {
      return val is timestamp;
    }

    function isValidEmail(val) {
      return val is string && val.matches('^[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}$');
    }

    function isValidPhone(val) {
      return val is string && val.size() >= 1 && val.size() <= 40;
    }

    function isValidRole(val) {
      return val in ['owner', 'management', 'staff', 'mechanic'];
    }

    function isValidDocType(val) {
      return val in ['pdf', 'image', 'text', 'other'];
    }

    // --- Validation Helpers (Merged: App + Live) ---

    // Company: supports both /company/default and /companies/{id}
    function isValidCompany(data) {
      return data.keys().hasAll(['id', 'shopName']) &&
        isValidId(data.id) &&
        isNonEmptyString(data.shopName, 200) &&
        (!('ownerEmail' in data) || isValidEmail(data.ownerEmail)) &&
        (!('phone' in data) || isValidOptString(data.phone, 50)) &&
        (!('address' in data) || isValidOptString(data.address, 500)) &&
        (!('cityStateZip' in data) || isValidOptString(data.cityStateZip, 120)) &&
        (!('timezone' in data) || isValidOptString(data.timezone, 100)) &&
        (!('email' in data) || isValidOptString(data.email, 120)) &&
        (!('iowaTaxRate' in data) || ((data.iowaTaxRate is int || data.iowaTaxRate is float) && data.iowaTaxRate >= 0 && data.iowaTaxRate <= 25)) &&
        (!('workOrderPrefix' in data) || isValidOptString(data.workOrderPrefix, 15)) &&
        (!('nextOrderNumber' in data) || ((data.nextOrderNumber is int || data.nextOrderNumber is float) && data.nextOrderNumber >= 1)) &&
        (!('receiptFooter' in data) || isValidOptString(data.receiptFooter, 500)) &&
        (!('updatedByUid' in data) || isValidOptString(data.updatedByUid, 128)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('createdBy' in data) || isValidOptString(data.createdBy, 200)) &&
        (!('isActive' in data) || data.isActive is bool) &&
        (!('staffEmailKeys' in data) || data.staffEmailKeys is list) &&
        (!('maxStaffSeats' in data) || (data.maxStaffSeats is int && data.maxStaffSeats > 0));
    }

    // Staff: supports app fields (baySpecialty, active, createdByUid) + live fields (companyId, isActive, etc.)
    function isValidStaff(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
        isValidId(data.id) &&
        isNonEmptyString(data.name, 200) &&
        isValidReqString(data.email, 3, 120) &&
        isValidRole(data.role) &&
        (!('companyId' in data) || isValidId(data.companyId)) &&
        (!('baySpecialty' in data) || isValidOptString(data.baySpecialty, 80)) &&
        (!('active' in data) || data.active is bool) &&
        (!('isActive' in data) || data.isActive is bool) &&
        (!('phone' in data) || isValidOptString(data.phone, 40)) &&
        (!('isVerified' in data) || data.isVerified is bool) &&
        (!('acceptedAt' in data) || isValidTimestamp(data.acceptedAt)) &&
        (!('invitedBy' in data) || isValidOptString(data.invitedBy, 200)) &&
        (!('invitedAt' in data) || isValidTimestamp(data.invitedAt)) &&
        (!('createdByUid' in data) || isValidOptString(data.createdByUid, 128)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidReqString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Services: supports app fields (unitPrice, taxable, active, tire inventory) + live fields (price, durationMinutes, etc.)
    function isValidService(data) {
      return data.keys().hasAll(['id', 'name']) &&
        isValidId(data.id) &&
        isNonEmptyString(data.name, 200) &&
        (!('companyId' in data) || isValidId(data.companyId)) &&
        (!('category' in data) || (data.category in ['tire_repair', 'tire_sale', 'oil_change', 'tune_up', 'maintenance', 'part'] || isNonEmptyString(data.category, 100))) &&
        (!('description' in data) || isValidOptString(data.description, 2000)) &&
        (!('unitPrice' in data) || ((data.unitPrice is int || data.unitPrice is float) && data.unitPrice >= 0 && data.unitPrice <= 50000)) &&
        (!('price' in data) || ((data.price is int || data.price is float) && data.price >= 0)) &&
        (!('durationMinutes' in data) || (data.durationMinutes is int && data.durationMinutes > 0)) &&
        (!('taxable' in data) || data.taxable is bool) &&
        (!('active' in data) || data.active is bool) &&
        (!('isActive' in data) || data.isActive is bool) &&
        // Tire Inventory fields
        (!('stockQuantity' in data) || ((data.stockQuantity is int || data.stockQuantity is float) && data.stockQuantity >= 0)) &&
        (!('tireSize' in data) || isValidOptString(data.tireSize, 60)) &&
        (!('brand' in data) || isValidOptString(data.brand, 80)) &&
        (!('binLocation' in data) || isValidOptString(data.binLocation, 60)) &&
        (!('costPrice' in data) || ((data.costPrice is int || data.costPrice is float) && data.costPrice >= 0)) &&
        (!('updatedByUid' in data) || isValidOptString(data.updatedByUid, 128)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // Customer: supports both app format and live format
    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'name']) &&
        isValidId(data.id) &&
        isNonEmptyString(data.name, 200) &&
        (!('companyId' in data) || isValidId(data.companyId)) &&
        (!('phone' in data) || isValidOptString(data.phone, 40)) &&
        (!('email' in data) || isValidOptString(data.email, 120)) &&
        (!('notes' in data) || isValidOptString(data.notes, 2000)) &&
        (!('vehicles' in data) || data.vehicles is list) &&
        (!('active' in data) || data.active is bool) &&
        (!('isActive' in data) || data.isActive is bool) &&
        (!('createdByUid' in data) || isValidOptString(data.createdByUid, 128)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // Vehicle: supports both app format and live format (optional VIN/color/mileage)
    function isValidVehicle(data) {
      return data.keys().hasAll(['id', 'customerId']) &&
        isValidId(data.id) &&
        isValidId(data.customerId) &&
        (!('companyId' in data) || isValidId(data.companyId)) &&
        (!('customerName' in data) || isValidOptString(data.customerName, 120)) &&
        (!('year' in data) || ((data.year is int || data.year is float) && data.year >= 1900 && data.year <= 2100)) &&
        (!('make' in data) || isValidOptString(data.make, 100)) &&
        (!('model' in data) || isValidOptString(data.model, 100)) &&
        (!('licensePlate' in data) || isValidOptString(data.licensePlate, 30)) &&
        (!('vin' in data) || isValidOptString(data.vin, 50)) &&
        (!('color' in data) || isValidOptString(data.color, 50)) &&
        (!('mileage' in data) || ((data.mileage is int || data.mileage is float) && data.mileage >= 0 && data.mileage <= 2000000)) &&
        (!('notes' in data) || isValidOptString(data.notes, 2000)) &&
        (!('createdByUid' in data) || isValidOptString(data.createdByUid, 128)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // Line Items: supports both app schema (id, serviceId, name, category, isCatalogService, qty, unitPrice, taxable)
    // and live schema (serviceId, name, quantity, price, isCustom)
    function isValidLineItemsList(items) {
      return items is list &&
        items.size() >= 0 && items.size() <= 100 &&
        (items.size() == 0 || (
          items[0] is map &&
          items[0].keys().hasAny(['name', 'serviceId', 'id']) &&
          (!('name' in items[0]) || items[0].name is string) &&
          (!('qty' in items[0]) || ((items[0].qty is int || items[0].qty is float) && items[0].qty >= 0)) &&
          (!('quantity' in items[0]) || ((items[0].quantity is int || items[0].quantity is float) && items[0].quantity >= 0)) &&
          (!('unitPrice' in items[0]) || ((items[0].unitPrice is int || items[0].unitPrice is float) && items[0].unitPrice >= 0)) &&
          (!('price' in items[0]) || ((items[0].price is int || items[0].price is float) && items[0].price >= 0))
        ));
    }

    // Work Orders: MERGED to allow ALL app fields + live fields + ALL statuses
    function isValidWorkOrder(data) {
      return data.keys().hasAll([
          'id', 'status', 'customerId', 'vehicleId', 'lineItems', 'subtotal', 'total'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.customerId) &&
        isValidId(data.vehicleId) &&
        // Status allows both App ('intake', 'in_progress', 'waiting_on_parts', 'ready', 'paid', 'voided')
        // and Live ('pending', 'waiting_for_parts', 'completed', 'cancelled')
        (data.status in [
          'intake', 'pending', 'in_progress', 'waiting_on_parts', 'waiting_for_parts',
          'ready', 'paid', 'completed', 'voided', 'cancelled'
        ]) &&
        isValidLineItemsList(data.lineItems) &&
        (data.subtotal is int || data.subtotal is float) && data.subtotal >= 0 &&
        (data.total is int || data.total is float) && data.total >= 0 &&
        // App tax fields: taxRate (0 to 25, supports fraction e.g. 0.07 or percent e.g. 7.0) & taxAmount
        (!('taxRate' in data) || ((data.taxRate is int || data.taxRate is float) && data.taxRate >= 0 && data.taxRate <= 25)) &&
        (!('taxAmount' in data) || ((data.taxAmount is int || data.taxAmount is float) && data.taxAmount >= 0)) &&
        // Live tax field: tax
        (!('tax' in data) || ((data.tax is int || data.tax is float) && data.tax >= 0)) &&
        // App discount field
        (!('discount' in data) || ((data.discount is int || data.discount is float) && data.discount >= 0)) &&
        // Order numbers & metadata
        (!('orderNumber' in data) || isValidOptString(data.orderNumber, 40)) &&
        (!('companyId' in data) || isValidId(data.companyId)) &&
        (!('technicianId' in data) || isValidOptString(data.technicianId, 128)) &&
        (!('assignedMechanicId' in data) || isValidOptString(data.assignedMechanicId, 128)) &&
        (!('assignedMechanicName' in data) || isValidOptString(data.assignedMechanicName, 100)) &&
        (!('notes' in data) || isValidOptString(data.notes, 2000)) &&
        // Customer & vehicle denormalized snapshots
        (!('customerName' in data) || isValidOptString(data.customerName, 200)) &&
        (!('customerPhone' in data) || isValidOptString(data.customerPhone, 40)) &&
        (!('customerEmail' in data) || isValidOptString(data.customerEmail, 120)) &&
        (!('vehicleDescription' in data) || isValidOptString(data.vehicleDescription, 500)) &&
        (!('vehicleYear' in data) || ((data.vehicleYear is int || data.vehicleYear is float) && data.vehicleYear >= 1900 && data.vehicleYear <= 2100)) &&
        (!('vehicleMake' in data) || isValidOptString(data.vehicleMake, 60)) &&
        (!('vehicleModel' in data) || isValidOptString(data.vehicleModel, 60)) &&
        (!('licensePlate' in data) || isValidOptString(data.licensePlate, 30)) &&
        (!('vin' in data) || isValidOptString(data.vin, 50)) &&
        (!('mileage' in data) || ((data.mileage is int || data.mileage is float) && data.mileage >= 0 && data.mileage <= 2000000)) &&
        // Payment & Completion fields
        (!('paymentMethod' in data) || isValidOptString(data.paymentMethod, 30)) &&
        (!('amountPaid' in data) || ((data.amountPaid is int || data.amountPaid is float) && data.amountPaid >= 0)) &&
        (!('paidAt' in data) || (data.paidAt is string || isValidTimestamp(data.paidAt))) &&
        (!('paidByName' in data) || isValidOptString(data.paidByName, 100)) &&
        (!('paidByUid' in data) || isValidOptString(data.paidByUid, 128)) &&
        (!('completedAt' in data) || (data.completedAt is string || isValidTimestamp(data.completedAt))) &&
        (!('completedByName' in data) || isValidOptString(data.completedByName, 100)) &&
        (!('completedByUid' in data) || isValidOptString(data.completedByUid, 128)) &&
        // Void fields
        (!('isVoided' in data) || data.isVoided is bool) &&
        (!('isArchived' in data) || data.isArchived is bool) &&
        (!('voidReason' in data) || isValidOptString(data.voidReason, 500)) &&
        (!('voidedAt' in data) || (data.voidedAt is string || isValidTimestamp(data.voidedAt))) &&
        (!('voidedByName' in data) || isValidOptString(data.voidedByName, 100)) &&
        (!('voidedByUid' in data) || isValidOptString(data.voidedByUid, 128)) &&
        // Actor & Timestamp fields
        (!('createdByUid' in data) || isValidOptString(data.createdByUid, 128)) &&
        (!('createdByName' in data) || isValidOptString(data.createdByName, 100)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidCustomerUpdate(data) {
      return isValidCustomer(data);
    }

    function isValidVehicleUpdate(data) {
      return isValidVehicle(data);
    }

    function isValidWorkOrderUpdate(data) {
      return isValidWorkOrder(data);
    }

    // Work Order Audit Log (supports both /audit_log and /work_order_audit_log)
    function isValidWorkOrderAudit(data) {
      return data.keys().hasAll(['id', 'workOrderId', 'action']) &&
        isValidId(data.id) &&
        isValidId(data.workOrderId) &&
        isNonEmptyString(data.action, 100) &&
        (!('companyId' in data) || isValidId(data.companyId)) &&
        (!('actorId' in data) || isValidOptString(data.actorId, 200)) &&
        (!('actorUid' in data) || isValidOptString(data.actorUid, 128)) &&
        (!('actorName' in data) || isValidOptString(data.actorName, 100)) &&
        (!('actorRole' in data) || isValidOptString(data.actorRole, 40)) &&
        (!('timestamp' in data) || isValidTimestamp(data.timestamp)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('details' in data) || (data.details is string || data.details is map));
    }

    // Price Change Audit Log
    function isValidPriceAudit(data) {
      return data.keys().hasAll(['id']) &&
        isValidId(data.id) &&
        (!('serviceId' in data) || isValidId(data.serviceId)) &&
        (!('workOrderId' in data) || isValidId(data.workOrderId)) &&
        (!('companyId' in data) || isValidId(data.companyId)) &&
        (!('serviceName' in data) || isValidOptString(data.serviceName, 120)) &&
        (!('field' in data) || isValidOptString(data.field, 100)) &&
        (!('oldPrice' in data) || ((data.oldPrice is int || data.oldPrice is float) && data.oldPrice >= 0)) &&
        (!('newPrice' in data) || ((data.newPrice is int || data.newPrice is float) && data.newPrice >= 0)) &&
        (!('oldValue' in data) || (data.oldValue is number)) &&
        (!('newValue' in data) || (data.newValue is number)) &&
        (!('actorUid' in data) || isValidOptString(data.actorUid, 128)) &&
        (!('actorName' in data) || isValidOptString(data.actorName, 100)) &&
        (!('changedBy' in data) || isValidOptString(data.changedBy, 200)) &&
        (!('changedAt' in data) || isValidTimestamp(data.changedAt)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    // Staff Notifications
    function isValidStaffNotification(data) {
      return data.keys().hasAll(['id']) &&
        isValidId(data.id) &&
        (!('companyId' in data) || isValidId(data.companyId)) &&
        (!('staffId' in data) || isValidId(data.staffId)) &&
        (!('targetRole' in data) || isValidOptString(data.targetRole, 40)) &&
        (!('targetStaffId' in data) || isValidOptString(data.targetStaffId, 128)) &&
        (!('type' in data) || isValidOptString(data.type, 100)) &&
        (!('title' in data) || isValidOptString(data.title, 200)) &&
        (!('body' in data) || isValidOptString(data.body, 1000)) &&
        (!('message' in data) || isValidOptString(data.message, 2000)) &&
        (!('workOrderId' in data) || isValidOptString(data.workOrderId, 128)) &&
        (!('orderNumber' in data) || isValidOptString(data.orderNumber, 40)) &&
        (!('customerId' in data) || isValidOptString(data.customerId, 128)) &&
        (!('isRead' in data) || data.isRead is bool) &&
        (!('readByUids' in data) || data.readByUids is list) &&
        (!('createdByUid' in data) || isValidOptString(data.createdByUid, 128)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    // Shop Status (supports /shop_status/default and /shop_status/{id})
    function isValidShopStatus(data) {
      return data.keys().hasAll(['id']) &&
        isValidId(data.id) &&
        (!('companyId' in data) || isValidId(data.companyId)) &&
        (!('initialized' in data) || data.initialized is bool) &&
        (!('isOpen' in data) || data.isOpen is bool) &&
        (!('message' in data) || isValidOptString(data.message, 500)) &&
        (!('openHours' in data) || data.openHours is map) &&
        (!('createdByUid' in data) || isValidOptString(data.createdByUid, 128)) &&
        (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
        (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // --- Collection Rules ---

    // --- /shop_status ---
    match /shop_status/{statusId} {
      allow get: if isValidId(statusId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(statusId) && isVerified() &&
        isValidShopStatus(incoming()) &&
        incoming().id == statusId &&
        incoming().createdAt == request.time;
      allow update: if isValidId(statusId) && isVerified() &&
        isValidShopStatus(incoming()) &&
        incoming().id == statusId &&
        incoming().updatedAt == request.time &&
        (isManager() || isBootstrapAdmin());
      allow delete: if false;
    }

    // --- /company (App format: /company/default) ---
    match /company/{companyId} {
      allow get: if isValidId(companyId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(companyId) && isVerified() &&
        isValidCompany(incoming()) &&
        incoming().updatedAt == request.time &&
        (isManager() || !exists(/databases/$(database)/documents/company/default));
      allow update: if isValidId(companyId) && isVerified() &&
        isValidCompany(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        (isManager() || isBootstrapAdmin());
      allow delete: if false;
    }

    // --- /companies (Live format: /companies/{companyId}) ---
    match /companies/{companyId} {
      allow get: if isValidId(companyId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(companyId) && isVerified() &&
        isValidCompany(incoming()) &&
        incoming().id == companyId &&
        incoming().createdAt == request.time &&
        (isManager() || isBootstrapAdmin());
      allow update: if isValidId(companyId) && isVerified() &&
        isValidCompany(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        (isManager() || isBootstrapAdmin());
      allow delete: if false;
    }

    // --- /staff ---
    match /staff/{staffId} {
      allow get: if isValidId(staffId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(staffId) && isVerified() &&
        isValidStaff(incoming()) &&
        incoming().id == staffId &&
        incoming().createdAt == request.time &&
        (isManager() || isBootstrapAdmin() || !exists(/databases/$(database)/documents/company/default));
      allow update: if isValidId(staffId) && isVerified() &&
        isValidStaff(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        (isManager() || isBootstrapAdmin());
      allow delete: if false;
    }

    // --- /services ---
    match /services/{serviceId} {
      allow get: if isValidId(serviceId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(serviceId) && isVerified() &&
        isValidService(incoming()) &&
        incoming().id == serviceId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isManager() || isBootstrapAdmin());
      allow update: if isValidId(serviceId) && isVerified() &&
        isValidService(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time &&
        (isManager() || isBootstrapAdmin());
      allow delete: if false;
    }

    // --- /customers ---
    match /customers/{customerId} {
      allow get: if isValidId(customerId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(customerId) && isVerified() &&
        isValidCustomer(incoming()) &&
        incoming().id == customerId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(customerId) && isVerified() &&
        isValidCustomerUpdate(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- /vehicles ---
    match /vehicles/{vehicleId} {
      allow get: if isValidId(vehicleId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(vehicleId) && isVerified() &&
        isValidVehicle(incoming()) &&
        incoming().id == vehicleId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(vehicleId) && isVerified() &&
        isValidVehicleUpdate(incoming()) &&
        incoming().id == existing().id &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- /work_orders ---
    match /work_orders/{workOrderId} {
      allow get: if isValidId(workOrderId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(workOrderId) && isVerified() &&
        isValidWorkOrder(incoming()) &&
        incoming().id == workOrderId;

      allow update: if isValidId(workOrderId) && isVerified() &&
        isValidWorkOrderUpdate(incoming()) &&
        incoming().id == existing().id;

      allow delete: if false;

      // Subcollection 1: App audit trail (/work_orders/{id}/audit_log/{logId})
      match /audit_log/{logId} {
        allow get: if isValidId(workOrderId) && isValidId(logId) && isVerified();
        allow list: if isValidId(workOrderId) && isVerified();
        allow create: if isValidId(workOrderId) && isValidId(logId) && isVerified() &&
          isValidWorkOrderAudit(incoming()) &&
          incoming().id == logId &&
          incoming().workOrderId == workOrderId &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if false;
      }

      // Subcollection 2: Live audit trail (/work_orders/{id}/work_order_audit_log/{logId})
      match /work_order_audit_log/{logId} {
        allow get: if isValidId(workOrderId) && isValidId(logId) && isVerified();
        allow list: if isValidId(workOrderId) && isVerified();
        allow create: if isValidId(workOrderId) && isValidId(logId) && isVerified() &&
          isValidWorkOrderAudit(incoming()) &&
          incoming().id == logId &&
          incoming().workOrderId == workOrderId &&
          incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if false;
      }
    }

    // --- /price_audit_log ---
    match /price_audit_log/{logId} {
      allow get: if isValidId(logId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(logId) && isVerified() &&
        isValidPriceAudit(incoming()) &&
        incoming().id == logId &&
        incoming().createdAt == request.time &&
        (isManager() || isBootstrapAdmin());
      allow update: if false;
      allow delete: if false;
    }

    // --- /staff_notifications ---
    match /staff_notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isVerified();
      allow list: if isVerified();
      allow create: if isValidId(notificationId) && isVerified() &&
        isValidStaffNotification(incoming()) &&
        incoming().id == notificationId &&
        incoming().createdAt == request.time;
      allow update: if isValidId(notificationId) && isVerified() &&
        isValidStaffNotification(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }
  }
}
